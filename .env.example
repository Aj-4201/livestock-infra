# Copy to .env and edit. NEVER commit .env (public repo — see meeting security note).
POSTGRES_USER=livestock
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=livestock
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
ADMINER_PORT=8080

# Direct connection (migrations)
DATABASE_URL=postgres://livestock:change_me_locally@localhost:5432/livestock?sslmode=disable
# Pooled connection (application runtime)
POOLED_DATABASE_URL=postgres://livestock:change_me_locally@localhost:6432/livestock?sslmode=disable
